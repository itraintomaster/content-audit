{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiz-instruction-verdict.schema.json",
  "title": "QuizInstructionVerdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "quizId",
    "followsInstructions",
    "confidence",
    "severity",
    "reason",
    "violations",
    "checkedConstraints"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "quizId": { "type": "string" },
    "followsInstructions": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "severity": {
      "type": "string",
      "enum": ["none", "minor", "major", "critical"]
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "constraint", "evidence", "explanation"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "constraint": { "type": "string", "minLength": 1, "maxLength": 240 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 300 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "checkedConstraints": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "constraint", "status", "evidence"],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "answer_reconstruction",
              "grammar",
              "meaning",
              "solvability",
              "explicit_instruction"
            ]
          },
          "constraint": { "type": "string", "minLength": 1, "maxLength": 240 },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_applicable"]
          },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
