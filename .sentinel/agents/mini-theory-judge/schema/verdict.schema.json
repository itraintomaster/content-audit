{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mini-theory-verdict.schema.json",
  "title": "MiniTheoryVerdict",
  "description": "Un assessment independiente por quizId; el tema es sólo la unidad de consulta.",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessments"],
  "properties": {
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quizId", "holds", "problem", "severity", "counterexample", "explanation"],
        "properties": {
          "quizId": {"type": "string", "minLength": 1},
          "holds": {"type": "boolean"},
          "problem": {
            "type": ["string", "null"],
            "enum": ["FALSE_RULE", "INSUFFICIENT_FOR_QUIZ", "OVERSTATED_FOR_QUIZ", "OTHER_SUBTOPIC_CONTENT", null]
          },
          "severity": {"type": ["string", "null"], "enum": ["HIGH", "MEDIUM", "LOW", null]},
          "counterexample": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 800}
        },
        "if": {"properties": {"holds": {"const": true}}, "required": ["holds"]},
        "then": {
          "properties": {
            "problem": {"type": "null"},
            "severity": {"type": "null"},
            "counterexample": {"type": "null"}
          }
        },
        "else": {
          "properties": {
            "problem": {"type": "string"},
            "severity": {"type": "string"},
            "counterexample": {"type": "string"}
          },
          "allOf": [
            {
              "if": {"properties": {"problem": {"enum": ["FALSE_RULE", "INSUFFICIENT_FOR_QUIZ"]}}},
              "then": {"properties": {"severity": {"const": "HIGH"}}}
            },
            {
              "if": {"properties": {"problem": {"const": "OVERSTATED_FOR_QUIZ"}}},
              "then": {"properties": {"severity": {"const": "MEDIUM"}}}
            },
            {
              "if": {"properties": {"problem": {"const": "OTHER_SUBTOPIC_CONTENT"}}},
              "then": {"properties": {"severity": {"const": "LOW"}}}
            }
          ]
        }
      }
    }
  }
}
