      },
      "resolution": "unsafe-run-id",
      "expect": {
        "route": "failed",
        "errorContains": [
          "run_id ausente o inseguro"
        ]
      }
    },
    {
      "caseId": "sin-run-dir",
      "note": "Sin run_dir ni project_root no hay dónde leer: falla el gate y emit da outputUnusable.",
      "inputs": "ingeniera",
      "verdict": {
        "answer": "no"
      },
      "resolution": "none",
      "expect": {
        "route": "failed",
        "errorContains": [
          "faltan run_dir"
        ]
      }
    },
    {
      "caseId": "sin-salida-de-evaluate",
      "note": "evaluate no dejó verdicts.json.",
      "inputs": "ingeniera",
      "expect": {
        "route": "failed",
        "errorContains": [
          "verdicts.json no existe"
        ]
      }
    },
    {
      "caseId": "validated-viejo-se-borra",
      "note": "Un validated-verdict.json de un intento anterior no sobrevive a un gate que falla.",
      "inputs": "ingeniera",
      "raw": "no hay veredicto",
      "staleValidated": true,
      "expect": {
        "route": "failed",
        "errorContains": [
          "no es un objeto JSON"
        ]
      }
    },
    {
      "caseId": "no-es-json",
      "note": "Prosa sin objeto JSON.",
      "inputs": "ingeniera",
      "raw": "No puedo contestar.",
      "expect": {
        "route": "failed",
        "errorContains": [
          "no es un objeto JSON"
        ]
      }
    },
    {
      "caseId": "lista-en-vez-de-objeto",
      "note": "Un array no es el veredicto.",
