        ]
      }
    },
    {
      "caseId": "validated-corrupto-antes-de-emit",
      "note": "Si validated-verdict.json no se puede leer, emit no inventa: outputUnusable.",
      "inputs": "ingeniera",
      "verdict": {
        "answer": "no"
      },
      "corruptValidated": true,
      "expect": {
        "route": "passed",
        "canonical": {
          "answer": "no"
        }
      }
    },
    {
      "caseId": "fence-json",
      "note": "La salida en un fence ```json se acepta sin pagar otra consulta.",
      "inputs": "ingeniera",
      "raw": "```json\n{\n  \"answer\": \"no\"\n}\n```",
      "expect": {
        "route": "passed",
        "canonical": {
          "answer": "no"
        }
      }
    },
    {
      "caseId": "prosa-alrededor",
      "note": "Prosa antes y una etiqueta después: se toma el objeto.",
      "inputs": "ingeniera",
      "raw": "Esta es mi respuesta:\n{\"answer\": \"no\"}\nLABEL: done",
      "expect": {
        "route": "passed",
        "canonical": {
          "answer": "no"
        }
      }
    },
    {
      "caseId": "json-dentro-de-un-string",
      "note": "El objeto serializado dentro de un string JSON se desenvuelve.",
      "inputs": "ingeniera",
      "raw": "\"{\\\"answer\\\": \\\"no\\\"}\"",
      "expect": {
        "route": "passed",
        "canonical": {
          "answer": "no"
        }
      }
    }
  ]
}
