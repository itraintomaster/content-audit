      "expect": {
        "route": "failed",
        "errorContains": [
          "no es un objeto JSON"
        ]
      }
    },
    {
      "caseId": "output-unusable-del-modelo",
      "note": "{\"outputUnusable\": true} lo produce emit, nunca el modelo: el gate lo rechaza.",
      "inputs": "ingeniera",
      "verdict": {
